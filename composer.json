{
  "name": "k-kinzal/ztd-query-postgres",
  "description": "PostgreSQL platform support for ZTD Query",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "k-kinzal/ztd-query-core": "@dev"
  },
  "require-dev": {
    "brianium/paratest": "^7.3",
    "deptrac/deptrac": "^3.0",
    "friendsofphp/php-cs-fixer": "^3.95.24",
    "k-kinzal/php-ai-toolkit": "dev-main",
    "k-kinzal/sql-faker": "@dev",
    "nikic/php-fuzzer": "^0.0.11",
    "phpbench/phpbench": "^1.4",
    "phpcompatibility/php-compatibility": "^10.0.0-alpha2",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^4.0.4"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/k-kinzal/php-ai-toolkit.git"
    }
  ],
  "autoload": {
    "psr-4": {
      "ZtdQuery\\Platform\\Postgres\\": "src/"
    },
    "files": [
      "src/Compatibility/ClassAliases.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "Fuzz\\": "fuzz/",
      "Bench\\": "bench/"
    }
  },
  "scripts": {
    "bench": "phpbench run --report=aggregate",
    "bench:quick": "phpbench run --report=aggregate --warmup=1 --iterations=3 --retry-threshold=10",
    "bench:full": "@bench",
    "test": "paratest --processes=auto",
    "test:unit": "phpunit --testsuite unit",
    "test:fuzz": "phpunit fuzz/",
    "lint": [
      "@format:check",
      "@phpstan",
      "@compat",
      "@loc-guard",
      "@tree-guard",
      "@deptrac"
    ],
    "format": "php-cs-fixer fix --allow-risky=yes",
    "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
    "fuzz": [
      "@fuzz:robustness",
      "@fuzz:robustness:classify",
      "@fuzz:robustness:rewrite"
    ],
    "fuzz:robustness": "php-fuzzer fuzz fuzz/fuzz_robustness.php fuzz/corpus/robustness/",
    "fuzz:robustness:classify": "php-fuzzer fuzz fuzz/fuzz_robustness_classify.php fuzz/corpus/robustness-classify/",
    "fuzz:robustness:rewrite": "php-fuzzer fuzz fuzz/fuzz_robustness_rewrite.php fuzz/corpus/robustness-rewrite/",
    "doctest": "phpunit --testsuite doctest",
    "phpstan": "phpstan analyse --memory-limit=512M",
    "compat": "phpcs",
    "loc-guard": "loc-guard --config=loc.yaml",
    "tree-guard": "tree-guard --config=tree.yaml",
    "deptrac": [
      "deptrac analyse --config-file=deptrac.yaml --fail-on-uncovered --report-uncovered",
      "deptrac debug:unassigned --config-file=deptrac.yaml"
    ],
    "deptrac:debug": [
      "deptrac debug:unassigned --config-file=deptrac.yaml",
      "deptrac debug:unused --config-file=deptrac.yaml"
    ],
    "docgen": "cd ../.. && packages/ztd-query-postgres/vendor/bin/docgen --packages=packages/ztd-query-postgres --deptrac=\"$(pwd)/packages/ztd-query-postgres/deptrac.yaml\" --exclude=packages/ztd-query-postgres/src/Compatibility/ClassAliases.php --exclude='packages/ztd-query-postgres/../ztd-query-core/tests/*' --output=packages/ztd-query-postgres/build/docs --cache-dir=packages/ztd-query-postgres/build/docgen-cache --title=k-kinzal/ztd-query-postgres",
    "docgen:serve": "@docgen --serve",
    "docgen:diff": "@docgen --diff=origin/main --serve",
    "docgen:fresh": "@docgen --no-cache"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true,
    "platform": {
      "php": "8.1.0"
    }
  },
  "support": {
    "source": "https://github.com/k-kinzal/ztd-query-php/tree/main/packages/ztd-query-postgres",
    "docs": "https://k-kinzal.github.io/ztd-query-php/ztd-query-postgres/k-kinzal/ztd-query-postgres/"
  }
}
